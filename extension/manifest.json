{
  "manifest_version": 3,
  "name": "FocusGuard - Tab Distraction Shield",
  "version": "2.0.0",
  "description": "In-page DOM warning HUD, video pause, and tab-level distraction blocker for FocusGuard.",
  "key": "",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "*://127.0.0.1/*",
      "*://localhost/*",
      "*://*.vercel.app/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusGuard Controller"
  }
}
